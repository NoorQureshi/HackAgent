{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/noorqureshi/SploitAgent/schemas/skill.schema.json",
  "title": "SploitAgent Skill frontmatter",
  "description": "Contract for the YAML frontmatter of every skills/<domain>/<slug>/SKILL.md. Validated by `tools/catalog.py` and CI.",
  "type": "object",
  "required": [
    "name",
    "description",
    "domain",
    "type",
    "stability",
    "modes",
    "schema_version"
  ],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Globally unique, kebab-case, domain-prefixed slug (e.g. web-ssrf, api-graphql)."
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "description": "The auto-load trigger line. Must pack concrete signals: service/version, vuln class, tool-output patterns, error strings, ports."
    },
    "domain": {
      "type": "string",
      "enum": [
        "recon",
        "web",
        "api",
        "mobile",
        "cloud",
        "network",
        "wireless",
        "ad",
        "ai-ml",
        "code-review",
        "exploit-dev",
        "reverse-engineering",
        "hardware",
        "cryptography",
        "privesc",
        "defense",
        "payloads",
        "reporting",
        "automation",
        "tradecraft",
        "social-eng"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "technique",
        "arsenal",
        "methodology",
        "checklist",
        "reference"
      ],
      "description": "arsenal = tool selection; technique = a concrete chain; methodology = how-to-operate; checklist = ordered list; reference = payloads/tables."
    },
    "stability": {
      "type": "string",
      "enum": [
        "locked",
        "learning"
      ],
      "description": "locked = curated core, change deliberately; learning = the open contribution surface."
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "pentest",
          "bugbounty",
          "defense"
        ]
      },
      "description": "Which authorization contexts this skill is valid in: pentest engagement, bug-bounty program, or defensive use."
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owasp": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owasp_llm": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owasp_api": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mitre": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MITRE ATT&CK technique IDs, e.g. T1190."
    },
    "cwe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": [
        "array",
        "string"
      ]
    },
    "learned_on": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
